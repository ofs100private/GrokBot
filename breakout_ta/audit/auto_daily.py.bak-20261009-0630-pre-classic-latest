CLASSIC_AGENT_PORTFOLIO_ID = "90db6cc2-57e3-48e0-9a12-3cbe82ac49ed"  # OfersClaw5-PRIYN agent portfolio (data source)
CLASSIC_MAX_AGE_MIN = 30
CLASSIC_SIDECARS = [
