+def _sl_bounds_ok(sl: Optional[float], anchor_ask: float, atr_d: Optional[float], asset_class: Optional[str]) -> dict:
+    res: dict[str, Any] = {"stopLossRate": sl, "anchor_ask": anchor_ask, "daily_atr": atr_d}
