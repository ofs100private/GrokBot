--- classic_rsi_orig/trade_counter.py	1970-01-01 02:00:00.000000000 +0200
+++ /workspace/classic_rsi/trade_counter.py	2026-10-16 01:29:23.851831794 +0300
@@ -0,0 +1,83 @@
+"""Daily NEW-trade counter (Ofer 2026-10-16 01:27 IDT): max 4 new opens per IDT calendar day.
+
+SL edits and protective/risk exits do NOT count. Persisted to a JSON file so every runner
+(hourly RSI, rebalance, manual) shares one budget. Fails closed: unreadable file => limit reached.
+"""
+from __future__ import annotations
+
+import json
+import os
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Optional
+from zoneinfo import ZoneInfo
+
+IDT = ZoneInfo("Asia/Jerusalem")
+MAX_NEW_TRADES_PER_DAY = 4
+COUNTER_PATH = Path(os.environ.get("CLASSIC_TRADE_COUNTER", "/workspace/classic_rsi/state/daily_new_trades.json"))
+
+
+def _day(now: Optional[datetime] = None) -> str:
+    return (now or datetime.now(IDT)).astimezone(IDT).strftime("%Y-%m-%d")
+
+
+def _load(path: Path) -> Optional[dict[str, Any]]:
+    if not path.exists():
+        return {}
+    try:
+        d = json.loads(path.read_text())
+        return d if isinstance(d, dict) else None
+    except Exception:  # noqa: BLE001
+        return None
+
+
+def status(now: Optional[datetime] = None, path: Optional[Path] = None, book_opens_today: int = 0) -> dict[str, Any]:
+    path = path or COUNTER_PATH
+    d = _load(path)
+    day = _day(now)
+    if d is None:
+        return {"day": day, "count": None, "max": MAX_NEW_TRADES_PER_DAY, "remaining": 0,
+                "ok": False, "error": f"counter unreadable: {path}"}
+    trades = list((d.get(day) or {}).get("trades") or [])
+    count = max(len(trades), int(book_opens_today or 0))
+    rem = max(0, MAX_NEW_TRADES_PER_DAY - count)
+    return {"day": day, "count": count, "file_count": len(trades), "book_opens_today": book_opens_today,
+            "max": MAX_NEW_TRADES_PER_DAY, "remaining": rem, "ok": rem > 0, "path": str(path)}
+
+
+def record(symbol: str, *, position_id: Any = None, instrument_id: Any = None, now: Optional[datetime] = None,
+           path: Optional[Path] = None) -> dict[str, Any]:
+    """Call ONLY after a NEW buy is confirmed placed. Not for SL edits / exits."""
+    path = path or COUNTER_PATH
+    d = _load(path)
+    if d is None:
+        raise RuntimeError(f"counter unreadable: {path}")
+    n = now or datetime.now(IDT)
+    day = _day(n)
+    d.setdefault(day, {"trades": []})["trades"].append(
+        {"symbol": symbol, "positionId": position_id, "instrumentId": instrument_id,
+         "at": n.astimezone(IDT).isoformat(timespec="seconds")})
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(d, indent=2))
+    tmp.replace(path)
+    return status(n, path)
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    import argparse
+    ap = argparse.ArgumentParser(description=__doc__)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    sub.add_parser("status")
+    r = sub.add_parser("record")
+    r.add_argument("--symbol", required=True)
+    r.add_argument("--position-id")
+    r.add_argument("--instrument-id")
+    a = ap.parse_args(argv)
+    out = status() if a.cmd == "status" else record(a.symbol, position_id=a.position_id, instrument_id=a.instrument_id)
+    print(json.dumps(out, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
