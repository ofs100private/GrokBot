+def main() -> int:
+    res = run()
+    for n, ok, d in res:
+        print(f"{'PASS' if ok else 'FAIL'}  {n}" + (f"  [{d}]" if not ok and d != "" else ""))
+    nf = sum(1 for _, ok, _ in res if not ok)
+    print(f"{len(res) - nf}/{len(res)} passed")
+    return 1 if nf else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
