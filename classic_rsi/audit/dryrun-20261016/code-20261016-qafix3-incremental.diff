+    return keys
+
+
+def release_blocker(orders: dict[str, Any], history: dict[str, Any]):
+    """Return fn(slot, reserved_at) -> reason|None for TC.release_stale."""
+    def fn(slot: dict, reserved_at: datetime) -> Optional[str]:
+        iid = slot.get("instrumentId")
