+
+def main() -> int:
+    res = run()
+    for name, ok, detail in res:
+        print(f"{'PASS' if ok else 'FAIL'}  {name}" + (f"  [{detail}]" if not ok and detail != "" else ""))
+    n_fail = sum(1 for _, ok, _ in res if not ok)
+    print(f"{len(res) - n_fail}/{len(res)} passed")
