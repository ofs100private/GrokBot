-    close_fee  = from prepare/getCost, else DEFAULT_CLOSE_FEE_USD
-    overnight  = financing for the planned hold; 0 for x1 long real stock/ETF unless prepare says otherwise
-    tax_est    = TAX_RATE x max(realized_pnl, 0)   (sells/trims of winners only)
-    total_cost = spread + open_fee + close_fee + overnight + tax_est
-
