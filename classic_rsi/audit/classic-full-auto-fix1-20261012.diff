+def _finish(out: dict, c: _Ctx, lp: Optional[Path], write_lock: bool) -> dict:
+    out["checks"] = c.checks
+    out["blockers"] = c.blockers
+    out.setdefault("ready_for_order_qa", False)
+    go = not c.blockers
+    if go and lp is not None and write_lock:
+        lp.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            fd = os.open(str(lp), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+            with os.fdopen(fd, "w") as fh:
+                json.dump({"pack_id": out.get("pack_id"), "pack_sha256": out.get("pack_sha256"),
+                           "go_at": c.now.isoformat()}, fh)
+            out["lock"] = str(lp)
+        except FileExistsError:
+            c.check("not_already_go", False, {"lock": str(lp), "race": True}, "ALREADY_GO_LOCKED")
+            go = False
+    out["decision"] = "GO" if go else "NO-GO"
+    out["note"] = ("GO = Trader_Classic places order_payloads VERBATIM via user-OfersClaw5 (sells first, one "
+                   "call each), re-reading cash (<=60s) between sequenced places. This CLI never places."
+                   if go else "NO-GO = do not place. Log the skip with the numbers.")
+    return out
