+def _parse_ts(ts: Any) -> Optional[datetime]:
+    if ts is None:
+        return None
+    if isinstance(ts, datetime):
+        d = ts
+    else:
+        try:
+            d = datetime.fromisoformat(str(ts).replace("Z", "+00:00"))
+        except ValueError:
+            return None
+    return d if d.tzinfo else None  # naive timestamps are rejected (ambiguous zone)
+
+
+def quote_errors(*, bid: Any, ask: Any, quote_ts: Any, now: Optional[datetime] = None,
+                 independent_mark: Any = None, max_age_s: float = QUOTE_MAX_AGE_S) -> list[str]:
+    """Final-stage live-quote checks. Empty list = OK."""
+    errs: list[str] = []
+    b, a = _f(bid), _f(ask)
+    if b is None or a is None:
+        errs.append("QUOTE_MISSING")
+        return errs
+    if b <= 0 or a <= 0 or b >= a:
+        errs.append("QUOTE_BID_GE_ASK_OR_NONPOSITIVE")
+    t = _parse_ts(quote_ts)
+    now = now or datetime.now(timezone.utc)
+    if t is None:
+        errs.append("QUOTE_TS_MISSING")
+    else:
+        age = (now - t).total_seconds()
+        if age > max_age_s or age < -5:
+            errs.append(f"QUOTE_STALE(age={age:.0f}s>{max_age_s:.0f}s)")
+    m = _f(independent_mark)
+    if m is not None and a and abs(a - m) / m > MARK_TOL:
+        errs.append("ASK_VS_MARK_GT_0.1PCT")
+    return errs
+
+
+def edge_errors(edge: Any, *, rotation: bool = False) -> list[str]:
+    if not isinstance(edge, dict):
+        return ["EDGE_MISSING"]
+    errs = []
+    if edge.get("method") not in EDGE_METHODS:
+        errs.append(f"EDGE_METHOD_NOT_IN_{'/'.join(EDGE_METHODS)}")
+    if _f(edge.get("expected_return_pct")) is None:
+        errs.append("EDGE_EXPECTED_RETURN_MISSING")
+    if rotation and _f(edge.get("held_expected_return_pct")) is None:
+        errs.append("EDGE_HELD_EXPECTED_RETURN_MISSING")
+    if _f(edge.get("horizon_days")) is None or _f(edge.get("horizon_days")) <= 0:
+        errs.append("EDGE_HORIZON_MISSING")
+    ev = edge.get("evidence") or {}
+    if not (isinstance(ev, dict) and str(ev.get("source") or "").strip() and (_f(ev.get("n")) or 0) >= 1):
+        errs.append("EDGE_NO_CITED_EVIDENCE")
+    return errs
+
