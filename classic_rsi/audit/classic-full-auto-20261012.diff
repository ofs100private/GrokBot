+                      take_profit=lv.get("take_profit"), stop_loss=lv.get("stop_loss"),
+                      stage="preliminary")
+    except ValueError as exc:
+        return {"version": VERSION, "stage": "preliminary", "binding": False, "kind": "rsi_buy",
+                "rule": RULE, "verdict": VERDICT_SKIP, "method": f"error: {exc}",
+                "total_cost": None, "expected_gain": None, "ratio": None, "assumptions": []}
+    cg["note"] = ("PRELIMINARY: assumed spread/fees (no live eToro access in-script). "
