+        return _finish(out, checks, blockers, pack)
+    max_cash_units = _floor_units((cash - CASH_FLOOR_USD - of) / ask_f)
+    if fu > max_cash_units:
+        shrink.append({"reason": "cash_floor", "from_units": fu, "to_units": max_cash_units})
+        fu = max_cash_units
+
+    # caps
+    asset_class = (resolve(symbol) or {}).get("assetClass") or inst.get("assetClass")
+    if check("book_loaded", book.get("ok"), book.get("error"), "BOOK_MISSING"):
+        vals = dict(book["values"])
+        inv = float(book["invested_value"])
+        cap = NAME_CAP.get(str(asset_class or ""), None)
+        if check("asset_class_known", cap is not None, asset_class, "ASSET_CLASS_UNKNOWN"):
+            cur = vals.get(symbol, 0.0)
+            # (cur + x) <= cap * (inv + x)  ->  x <= (cap*inv - cur) / (1 - cap)
+            max_name_usd = (cap * inv - cur) / (1 - cap)
+            max_name_units = _floor_units(max_name_usd / ask_f)
+            if fu > max_name_units:
+                shrink.append({"reason": f"name_cap_{int(cap * 100)}pct", "from_units": fu, "to_units": max_name_units})
+                fu = max_name_units
+        smap = {**DEFAULT_SLEEVES, **(sleeve_map or {})}
+        if sleeve:
+            smap[symbol] = sleeve
+        unknown = sorted(s for s in set(vals) | {symbol} if s not in smap)
+        if check("sleeves_known", not unknown, {"unknown": unknown}, "SLEEVE_UNKNOWN"):
+            sl = smap[symbol]
+            sleeve_cur = sum(v for s, v in vals.items() if smap.get(s) == sl)
+            max_sleeve_usd = (SLEEVE_CAP * inv - sleeve_cur) / (1 - SLEEVE_CAP)
+            max_sleeve_units = _floor_units(max_sleeve_usd / ask_f)
+            if fu > max_sleeve_units:
+                shrink.append({"reason": "sleeve_cap_45pct", "from_units": fu, "to_units": max_sleeve_units})
+                fu = max_sleeve_units
+            notional = fu * ask_f
+            inv_after = inv + notional
+            out["caps_after"] = {
+                "name_pct": round((vals.get(symbol, 0.0) + notional) / inv_after * 100, 2) if inv_after else None,
+                "name_cap_pct": (cap or 0) * 100,
+                "sleeve": sl,
+                "sleeve_pct": round((sleeve_cur + notional) / inv_after * 100, 2) if inv_after else None,
+                "sleeve_cap_pct": SLEEVE_CAP * 100,
+                "invested_value_after": round(inv_after, 2),
+            }
+    final_notional = fu * ask_f
+    cash_after = cash - final_notional - of
+    check("cash_after_ge_floor", cash_after >= CASH_FLOOR_USD - 1e-9,
+          {"cash": cash, "cash_after": round(cash_after, 2), "floor": CASH_FLOOR_USD}, "CASH_FLOOR")
+    check("min_position", final_notional >= MIN_POSITION_USD,
+          {"notional": round(final_notional, 2), "min": MIN_POSITION_USD}, "BELOW_MIN_POSITION")
+    out["sizing"] = {"requested_units": round(req_units, UNITS_DP), "final_units": fu,
+                     "final_notional_usd": round(final_notional, 2), "shrunk": bool(shrink),
+                     "shrink_steps": shrink, "cash_after_usd": round(cash_after, 2)}
+
+    cg = None
+    if fu > 0:
+        cg = final_gate_from_prepare(pack, bid=float(bid), ask=ask_f, units=fu, open_fee_usd=open_fee_usd,
+                                     close_fee_usd=close_fee_usd, overnight_usd=overnight_usd,
+                                     spread_usd=spread_usd)
+        out["cost_gate"] = cg
+        out["rebased_levels"] = cg.get("rebased_levels")
+    check("final_cost_gate", cg is not None and cg.get("verdict") == VERDICT_PASS,
+          None if cg is None else {"ratio": cg.get("ratio"), "expected_gain": cg.get("expected_gain"),
+                                   "total_cost": cg.get("total_cost"), "verdict": cg.get("verdict")},
+          "COST_GATE_SKIP")
+
+    pre_ok = not blockers
+    ok, why = _verdict_ok(order_qa_verdict, run_ids, symbol)
+    check("order_qa_pass", ok, why, "ORDER_QA_PENDING" if not order_qa_verdict else "ORDER_QA_NOT_PASS")
+    out["ready_for_order_qa"] = pre_ok
+    return _finish(out, checks, blockers, pack)
+
+
+def _finish(out: dict[str, Any], checks: list, blockers: list, pack: Optional[dict]) -> dict[str, Any]:
+    out["checks"] = checks
+    out["blockers"] = blockers
+    out.setdefault("ready_for_order_qa", False)
+    out["decision"] = "GO" if not blockers else "NO-GO"
+    out["note"] = ("GO = Trader_Classic may place this pack via user-OfersClaw5 (one call, final_units, "
+                   "rebased SL/TP). This CLI never places." if not blockers else
+                   "NO-GO = do not place. Blockers listed; log the skip with numbers.")
+    return out
+
+
+def write_audit(result: dict[str, Any], audit_dir: Path = DEFAULT_AUDIT_DIR) -> Path:
+    ts = datetime.now(IDT).strftime("%Y%m%d-%H%M%S")
+    sym = result.get("symbol") or "NA"
+    path = Path(audit_dir) / f"execute-pass-{result.get('run_id')}-{sym}-{ts}.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(result, indent=2, default=str) + "\n")
+    return path
+
+
+def main(argv: Optional[list[str]] = None) -> int:
+    p = argparse.ArgumentParser(description="Classic final pre-place checks (GO/NO-GO). Never calls eToro.")
+    p.add_argument("--pack-id", required=True, help="<run_id>#<SYMBOL>")
+    p.add_argument("--run-qa-verdict", required=True)
+    p.add_argument("--order-qa-verdict", default=None)
+    p.add_argument("--bid", type=float, required=True)
+    p.add_argument("--ask", type=float, required=True)
+    g = p.add_mutually_exclusive_group(required=True)
+    g.add_argument("--units", type=float)
+    g.add_argument("--amount", type=float, help="USD notional")
+    p.add_argument("--open-fee", type=float, default=None)
+    p.add_argument("--close-fee", type=float, default=None)
+    p.add_argument("--overnight", type=float, default=None)
+    p.add_argument("--spread-usd", type=float, default=None)
+    p.add_argument("--cash", type=float, default=None, help="live available cash (default: book snapshot)")
+    p.add_argument("--book", default=str(PORTFOLIO_SNAPSHOT))
+    p.add_argument("--sleeve", default=None)
+    p.add_argument("--sleeve-map", default=None, help="JSON file {symbol: sleeve}")
+    p.add_argument("--audit-dir", default=str(DEFAULT_AUDIT_DIR))
+    p.add_argument("--allow-weekend", action="store_true")
+    p.add_argument("--hold", action="store_true")
+    p.add_argument("--no-write", action="store_true")
+    a = p.parse_args(argv)
+    smap = json.loads(Path(a.sleeve_map).read_text()) if a.sleeve_map else None
+    res = run_checks(pack_id=a.pack_id, bid=a.bid, ask=a.ask, units=a.units, amount_usd=a.amount,
+                     open_fee_usd=a.open_fee, close_fee_usd=a.close_fee, overnight_usd=a.overnight,
+                     spread_usd=a.spread_usd, cash_usd=a.cash, run_qa_verdict=a.run_qa_verdict,
+                     order_qa_verdict=a.order_qa_verdict, book_path=Path(a.book), sleeve=a.sleeve,
+                     sleeve_map=smap, audit_dir=Path(a.audit_dir), allow_weekend=a.allow_weekend, hold=a.hold)
+    if not a.no_write:
+        res["audit_path"] = str(write_audit(res, Path(a.audit_dir)))
+    print(json.dumps(res, indent=2, default=str))
+    print(f"{res['decision']} {res['pack_id']} blockers={res['blockers'] or 'none'}", file=sys.stderr)
+    return 0 if res["decision"] == "GO" else 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
