+
+
+def run():
+    out = []
+
+    def t(name, cond, detail=""):
+        out.append((name, bool(cond), detail))
+
+    # --- formula: rsi_buy with live quote ---
+    cg = C.evaluate(kind="rsi_buy", entry=100.0, units=10, bid=99.95, ask=100.0, open_fee_usd=1,
+                    close_fee_usd=1, take_profit=104.0, stop_loss=97.0, stage="final")
