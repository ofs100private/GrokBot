+"""Cost/benefit gate for Classic (OfersClaw5-PRIYN) — mandatory before every place.
+
+Rule (Ofer 2026-10-11, skills classic-rebalance / trader-classic-strategy):
+    eligible  iff  expected_gain >= 2 x total_cost
+    (equivalently expected_net_gain = expected_gain - total_cost >= total_cost > 0)
+    otherwise verdict COST_GATE_SKIP.
+    Hard risk exits (stop hit, trigger 3/4, hard cap breach, cash below floor) are never
+    skipped: verdict RISK_EXIT, numbers still recorded.
+
+Round-trip cost (USD)
+    spread     = (ask - bid) x units          # buy at ask, exit at bid: one full spread vs mid
+                 (no live quote: notional x DEFAULT_SPREAD_PCT, marked assumed)
+    open_fee   = from prepare/getCost, else DEFAULT_OPEN_FEE_USD   (buys only)
+    close_fee  = from prepare/getCost, else DEFAULT_CLOSE_FEE_USD
+    overnight  = financing for the planned hold; 0 for x1 long real stock/ETF unless prepare says otherwise
+    tax_est    = TAX_RATE x max(realized_pnl, 0)   (sells/trims of winners only)
+    total_cost = spread + open_fee + close_fee + overnight + tax_est
+
+Expected gain (USD) — method is always recorded; never invented
+    rsi_buy        : (TP - entry) x units x P_HIT_RSI
+                     P_HIT_RSI = 0.43 = SL/(SL+TP) for the 1.5/2.0 ATR bracket, i.e. the
+                     zero-edge hit probability. The 1H backtest (backtest-summary-1h.json)
+                     pooled 12/19 = 0.63, but n=19 is too small; 0.43 is ~ its lower 95% bound.
+    rebalance_add  : entry x units x (ATR_d% x sqrt(hold_days)) x MOVE_HAIRCUT
+                     daily ATR(14) as % of price, hold default 20 trading days,
+                     MOVE_HAIRCUT 0.25 (expected directional edge = 1/4 of the 1-sigma move).
+    trim / sell    : caller supplies expected_gain_usd + method (replacement edge or risk
+                     removed); missing => COST_GATE_SKIP (cannot be justified).
+
+Stages
+    preliminary : computed in-script (propose/auto_1h) with no live eToro access — assumed
+                  spread/fees/notional; marked preliminary.
+    final       : recomputed at prepare time from the live prepare/getCost values via
+                  ``final_gate_from_prepare`` (used by execute_pass). Only FINAL is binding.
+
+This module never calls eToro and never places.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any, Optional
+
+VERSION = "classic-cost-gate-v1-20261012"
+RULE = "expected_gain >= 2 x total_cost"
+MULTIPLIER = 2.0
+
+TAX_RATE = 0.25  # conservative: Israeli capital-gains rate 25% on realized gains
+DEFAULT_SPREAD_PCT = 0.0015  # 0.15% of notional when no live bid/ask (conservative for liquid US names)
+# Per-order fee assumption when prepare/getCost gives none: $0.75, as charged on real Classic
+# fills 2026-10-07 (ADBE, GS, CAT at $500 each, keys/API orders).
+DEFAULT_FEE_SOURCE = "real Classic fills 2026-10-07 (ADBE/GS/CAT $500 each) charged $0.75 per order on keys"
+DEFAULT_OPEN_FEE_USD = 0.75
+DEFAULT_CLOSE_FEE_USD = 0.75
