+        assumptions.append(f"spread assumed {DEFAULT_SPREAD_PCT * 100:.2f}% of notional (no live quote)")
+        src.setdefault("spread", "assumed_default")
+    if is_buy:
+        of = _f(open_fee_usd)
+        if of is None:
