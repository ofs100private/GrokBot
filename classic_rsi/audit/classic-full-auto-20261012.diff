+    t("ratio 6.88 >= 2 => PASS", cg["verdict"] == "PASS" and math.isclose(cg["ratio"], 6.88), cg["ratio"])
+    t("final stage is binding", cg["binding"] is True and cg["stage"] == "final")
+    t("flat QA fields present", all(k in cg for k in ("spread", "fees", "overnight", "realized_pnl", "tax_est",
+                                                       "total_cost", "expected_gain", "expected_net_gain",
+                                                       "ratio", "method", "verdict")))
+    # 2x boundary: exactly 2x passes, just under is skipped
+    cg = C.evaluate(kind="rsi_buy", entry=100, units=1, spread_usd=0, open_fee_usd=1, close_fee_usd=1,
+                    take_profit=110, p_hit=0.4)  # 4.0 vs 2.0 -> exactly 2x
+    t("exactly 2x => PASS", cg["verdict"] == "PASS" and math.isclose(cg["ratio"], 2.0), cg["ratio"])
+    cg = C.evaluate(kind="rsi_buy", entry=100, units=1, spread_usd=0, open_fee_usd=1, close_fee_usd=1,
