+        "stage": stage,
+        "binding": stage == "final",
+        "kind": kind,
+        "rule": RULE,
+        "inputs": {
+            "entry": _r(entry_f), "units": _r(u, 6), "notional_usd": _r(notional, 2),
+            "bid": b, "ask": a, "take_profit": _f(take_profit), "stop_loss": _f(stop_loss),
+            "p_hit": (_f(p_hit) if p_hit is not None else (P_HIT_RSI if kind == "rsi_buy" else None)),
+            "daily_atr": _f(daily_atr), "hold_days": hd, "tax_rate": tax_rate,
+            "realized_pnl_usd": rp, "risk_exit": bool(risk_exit),
+            "sources": src,
+        },
+        "costs": {"spread": _r(spread, 4), "open_fee": _r(of, 4), "close_fee": _r(cf, 4),
+                  "overnight": _r(on, 4), "tax_est": _r(tax, 4), "total_cost": _r(total, 4)},
+        # flat fields required by order-QA
+        "spread": _r(spread, 4),
+        "fees": _r(of + cf, 4),
+        "overnight": _r(on, 4),
+        "realized_pnl": rp,
+        "tax_est": _r(tax, 4),
+        "total_cost": _r(total, 4),
+        "expected_gain": _r(eg, 4),
+        "expected_net_gain": _r(net, 4),
+        "ratio": (None if ratio is None else (_r(ratio, 3) if math.isfinite(ratio) else "inf")),
+        "method": method,
+        "verdict": verdict,
+        "assumptions": assumptions,
+    }
+
+
+def preliminary_for_pack(pack: dict[str, Any], *, notional_usd: Optional[float] = None) -> dict[str, Any]:
+    """Preliminary gate for an RSI buy pack (no live eToro data in-script)."""
+    lv = pack.get("levels") or {}
+    sz = (pack.get("sizing") or {}).get("suggested_notional_usd")
+    n = notional_usd if notional_usd is not None else _f(sz)
