+"""Offline tests for execute_pass (GO/NO-GO). Temp audit dir + temp book; never calls eToro.
+
+Run: cd /workspace && ./screener-venv/bin/python -m classic_rsi.test_execute_pass
+"""
+
+from __future__ import annotations
+
+import json
+import tempfile
+from datetime import datetime
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+from . import execute_pass as X
+from .propose import stamp_auto_place
+from .test_cost_gate import make_pack
+
+IDT = ZoneInfo("Asia/Jerusalem")
+MON = datetime(2026, 10, 12, 18, 0, tzinfo=IDT)
+SAT = datetime(2026, 10, 10, 18, 0, tzinfo=IDT)
+RID = "classic-rsi-auto-20261012-180000-testtest"
+PRID = "classic-rsi-propose-20261012-180005-testtest"
+
+
+def _setup(tmp: Path, packs, cash=3671.18):
+    rec = {"run_id": RID, "kind": "auto",
+           "payload": {"run_id": RID, "propose_run_id": PRID, "flags": [],
+                       "buy_packs": [dict(stamp_auto_place(p), run_id=PRID) for p in packs]}}
+    (tmp / f"{RID}.json").write_text(json.dumps(rec))
+    book = {"asOf": "2026-10-12T17:55:00+03:00", "summary": {"availableCash": cash},
+            "positions": [{"symbol": "QQQ", "value": 830.65}, {"symbol": "SMH", "value": 778.16},
+                          {"symbol": "XLV", "value": 774.44}, {"symbol": "SPY", "value": 705.82},
+                          {"symbol": "TMO", "value": 509.15}]}
+    (tmp / "book.json").write_text(json.dumps(book))
+    (tmp / "runqa.json").write_text(json.dumps({"verdict": "PASS", "run_id": RID, "propose_run_id": PRID}))
+    (tmp / "orderqa.json").write_text(json.dumps({"verdict": "PASS", "run_id": PRID, "symbol": "T"}))
+    (tmp / "runqa-fail.json").write_text(json.dumps({"verdict": "FAIL", "run_id": RID}))
+
+
+def _run(tmp, **kw):
+    base = dict(pack_id=f"{RID}#T", bid=27.03, ask=27.05, units=20.0, open_fee_usd=1.0, close_fee_usd=1.0,
+                run_qa_verdict=str(tmp / "runqa.json"), order_qa_verdict=str(tmp / "orderqa.json"),
+                book_path=tmp / "book.json", audit_dir=tmp, now=MON)
+    base.update(kw)
+    return X.run_checks(**base)
+
+
+def run():
+    out = []
+
+    def t(name, cond, detail=""):
+        out.append((name, bool(cond), detail))
+
+    with tempfile.TemporaryDirectory() as d:
+        tmp = Path(d)
+        tpack = make_pack("T", entry=27.0, atr=0.5, notional=1000)
+        spy_small = make_pack("SPY", entry=700.0, atr=3.0)
+        _setup(tmp, [tpack, spy_small])
+
+        r = _run(tmp)
+        t("clean pack => GO", r["decision"] == "GO" and r["blockers"] == [], r["blockers"])
+        t("GO carries final binding cost_gate", r["cost_gate"]["stage"] == "final" and r["cost_gate"]["verdict"] == "PASS")
+        t("SL/TP rebased on live ask", abs(r["rebased_levels"]["take_profit"] - (27.05 + 1.0)) < 1e-6
+          and abs(r["rebased_levels"]["stop_loss"] - (27.05 - 0.75)) < 1e-6, r["rebased_levels"])
+        t("never calls eToro / never places", r["never_calls_etoro"] is True and r["places"] is False)
+        t("instrumentId/etoroSymbol echoed", r["instrumentId"] == 1030 and r["etoroSymbol"] == "T.US")
+
+        r = _run(tmp, order_qa_verdict=None)
+        t("no order-QA => NO-GO ORDER_QA_PENDING but ready_for_order_qa", r["decision"] == "NO-GO"
+          and r["blockers"] == ["ORDER_QA_PENDING"] and r["ready_for_order_qa"] is True, r["blockers"])
+        r = _run(tmp, run_qa_verdict=str(tmp / "runqa-fail.json"))
+        t("run-QA FAIL => NO-GO", "RUN_QA_NOT_PASS" in r["blockers"])
+        r = _run(tmp, run_qa_verdict=str(tmp / "missing.json"))
+        t("run-QA missing => NO-GO", "RUN_QA_NOT_PASS" in r["blockers"])
+
+        # cash floor auto-shrink: cash 3000 -> max units (3000-2500-1)/27.05 = 18.447...
+        r = _run(tmp, cash_usd=3000.0)
+        t("cash floor auto-shrinks units", r["sizing"]["shrunk"] and r["sizing"]["final_units"] < 20
+          and r["sizing"]["cash_after_usd"] >= 2500 and r["decision"] == "GO", r["sizing"])
+        r = _run(tmp, cash_usd=2800.0)
+        t("shrunk below $400 min => NO-GO", "BELOW_MIN_POSITION" in r["blockers"], r["sizing"])
+
+        # name cap: stock 15% of invested (3598 + x): max x = (0.15*3598.22 - 0)/0.85 = 634.98
+        r = _run(tmp, units=40.0, cash_usd=6000.0)
+        t("stock name cap 15% auto-shrinks", any(s["reason"].startswith("name_cap_15") for s in r["sizing"]["shrink_steps"])
+          and r["caps_after"]["name_pct"] <= 15.0 + 1e-6, r.get("caps_after"))
+        # drift > 0.5 x ATR (0.25)
+        r = _run(tmp, bid=27.28, ask=27.30)
+        t("drift > 0.5xATR => NO-GO", "DRIFT" in r["blockers"], r["blockers"])
+        # live costs kill the edge -> final cost gate SKIP
+        r = _run(tmp, units=15.0, open_fee_usd=5.0, close_fee_usd=5.0)
+        t("live fees => final COST_GATE_SKIP => NO-GO", "COST_GATE_SKIP" in r["blockers"], r["cost_gate"]["ratio"])
+        # ineligible (preliminary SKIP) pack
+        r = _run(tmp, pack_id=f"{RID}#SPY", bid=699.9, ask=700.0, units=1.0)
+        t("prelim-SKIP pack => NOT_AUTO_PLACE_ELIGIBLE", "NOT_AUTO_PLACE_ELIGIBLE" in r["blockers"])
+        r = _run(tmp, pack_id=f"{RID}#ZZZZ")
+        t("unknown pack => PACK_NOT_FOUND", r["blockers"] == ["PACK_NOT_FOUND"])
+        r = _run(tmp, now=SAT)
+        t("weekend => NO-GO", "WEEKEND" in r["blockers"])
+        r = _run(tmp, hold=True)
+        t("explicit hold => NO-GO", "HOLD" in r["blockers"])
+        (tmp / "orderqa-other.json").write_text(json.dumps({"verdict": "PASS", "run_id": PRID, "symbol": "VZ"}))
+        r = _run(tmp, order_qa_verdict=str(tmp / "orderqa-other.json"))
+        t("order-QA for another symbol => NO-GO", "ORDER_QA_NOT_PASS" in r["blockers"])
