+def load_pack(run_id: str, symbol: str, audit_dir: Path = DEFAULT_AUDIT_DIR) -> tuple[Optional[dict], dict]:
+    """Find the buy pack for symbol in audit/<run_id>.json (auto envelope or propose payload)."""
+    path = Path(audit_dir) / f"{run_id}.json"
