+      and cg["inputs"]["sources"]["spread"] == "assumed_default"
+      and math.isclose(cg["total_cost"], 500 * 0.0015 + 1.5), cg["total_cost"])
+    t("default fees $0.75 each, source cited", C.DEFAULT_OPEN_FEE_USD == 0.75 and C.DEFAULT_CLOSE_FEE_USD == 0.75
+      and any("0.75" in a and "2026-10-07" in a for a in cg["assumptions"]), cg["assumptions"])
+    t("prelim not binding", cg["binding"] is False and cg["assumptions"])
+    # rebalance add (ATR hold)
+    cg = C.evaluate(kind="rebalance_add", entry=700, notional_usd=700, daily_atr=7.0, hold_days=20,
