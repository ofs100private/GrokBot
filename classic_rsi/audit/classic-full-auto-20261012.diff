+    t("rebalance_add verdict", cg["verdict"] == ("PASS" if exp >= 2 * cg["total_cost"] else "COST_GATE_SKIP"))
+    # trim with realized gain -> tax 25%
+    cg = C.evaluate(kind="trim", entry=600, units=1, bid=599.8, ask=600, close_fee_usd=1, realized_pnl_usd=40,
+                    expected_gain_usd=30, expected_gain_method="risk removed: cap breach 51%->30%")
+    t("trim: no open fee, tax = 25% x realized", cg["costs"]["open_fee"] == 0 and math.isclose(cg["tax_est"], 10.0))
+    t("trim: total = spread+close+tax", math.isclose(cg["total_cost"], 0.2 + 1 + 10), cg["total_cost"])
+    t("trim 30 vs 11.2 => PASS", cg["verdict"] == "PASS")
