+        else:
+            method = "rsi_tp: TP missing or <= entry"
+    elif kind == "rebalance_add":
+        atr_d = _f(daily_atr)
+        hd = hd or float(DEFAULT_HOLD_DAYS)
+        if atr_d is not None and atr_d > 0:
