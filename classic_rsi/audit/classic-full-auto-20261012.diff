+        assumptions.append(f"close fee assumed ${DEFAULT_CLOSE_FEE_USD:.2f} ({DEFAULT_FEE_SOURCE})")
+        src.setdefault("close_fee", "assumed_default")
+    else:
+        src.setdefault("close_fee", "prepare/getCost")
+    on = _f(overnight_usd)
+    if on is None:
+        on = DEFAULT_OVERNIGHT_USD
+        assumptions.append("overnight 0 (x1 long real stock/ETF)")
+        src.setdefault("overnight", "assumed_default")
+    rp = _f(realized_pnl_usd) if not is_buy else None
+    tax = tax_rate * max(rp or 0.0, 0.0) if not is_buy else 0.0
+    total = spread + of + cf + on + tax
