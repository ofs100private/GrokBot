+def evaluate(
+    *,
+    kind: str,
+    entry: float,
+    units: Optional[float] = None,
+    notional_usd: Optional[float] = None,
+    bid: Optional[float] = None,
+    ask: Optional[float] = None,
+    spread_usd: Optional[float] = None,
+    open_fee_usd: Optional[float] = None,
+    close_fee_usd: Optional[float] = None,
+    overnight_usd: Optional[float] = None,
+    take_profit: Optional[float] = None,
+    stop_loss: Optional[float] = None,
+    p_hit: Optional[float] = None,
+    daily_atr: Optional[float] = None,
+    hold_days: Optional[float] = None,
+    realized_pnl_usd: Optional[float] = None,
+    expected_gain_usd: Optional[float] = None,
+    expected_gain_method: Optional[str] = None,
