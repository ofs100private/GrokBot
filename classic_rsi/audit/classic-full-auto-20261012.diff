+    t("trim without expected gain => SKIP; loss => no tax", cg["verdict"] == "COST_GATE_SKIP" and cg["tax_est"] == 0)
+    cg = C.evaluate(kind="sell", entry=600, units=1, realized_pnl_usd=100, close_fee_usd=1, risk_exit=True)
+    t("risk exit recorded, not skipped", cg["verdict"] == "RISK_EXIT" and math.isclose(cg["tax_est"], 25.0))
+
+    # --- propose integration ---
+    p = make_pack("SPY", entry=700.0, atr=3.0)
+    cgp = p["cost_gate"]
+    t("pack carries preliminary cost_gate", cgp["stage"] == "preliminary" and cgp["kind"] == "rsi_buy"
+      and "PRELIMINARY" in cgp["note"])
+    t("fee_estimate no longer None", isinstance(p["fee_estimate"], dict) and p["fee_estimate"]["stage"] == "preliminary")
+    # SPY: TP dist 6.0, units 500/700, exp=6*0.714*0.43=1.84; cost 0.75+1.5 = 2.25 -> SKIP (ratio 0.82)
+    t("small-ATR SPY pack prelim COST_GATE_SKIP", cgp["verdict"] == "COST_GATE_SKIP" and p["status"] == "COST_GATE_SKIP",
