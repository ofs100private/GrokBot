+    # --- costs ---
+    b, a = _f(bid), _f(ask)
+    if spread_usd is not None and _f(spread_usd) is not None:
+        spread = abs(float(spread_usd))
+        src.setdefault("spread", "prepare/getCost")
+    elif b is not None and a is not None and a >= b > 0:
+        spread = (a - b) * u
+        src.setdefault("spread", "live bid/ask")
+    else:
