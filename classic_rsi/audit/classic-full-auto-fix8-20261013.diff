+++ b/classic_rsi/momentum_holdings.py
@@ -0,0 +1,190 @@
+"""Read-only Momentum holdings snapshot for the Classic cross-book rule (fix8).
+
+Standing rule (Ofer 2026-10-13 01:44 IDT): Classic must NEVER buy a symbol already held in the Momentum
+book (Momentum-HHHGDTJ, MCP namespace user-Momentum-HHHGDTJ, mirror 11630170). Sells/exits unaffected.
+
+Producer: an agent calls user-Momentum-HHHGDTJ `get-my-positions-and-orders` (READ ONLY, account real),
+saves the raw JSON response, then runs
+    cd /workspace && python3 -m classic_rsi.momentum_holdings --response /path/to/response.json
+which writes /workspace/momentum-holdings-for-classic.json atomically (test mode: <root>/momentum.json).
+This module never calls eToro and never writes to either account. Tokens/other fields are not stored.
+
+Snapshot: {kind, source, portfolio, mirrorId, account, asOf (IDT ISO, from the response timestamp),
+xRequestId, symbols[], instrumentIds[], holdings[{symbol, instrumentId, positionId, origin}],
+pendingBuyOrders[...]}. Pending buy orders and copied (mirror) positions count as held (conservative).
+Consumers: execute_pass (hard check at GO, <= 60 s old), propose / auto_1h (drop overlapping packs).
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import tempfile
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Optional
+from zoneinfo import ZoneInfo
+
+from .paths import paths
+
+IDT = ZoneInfo("Asia/Jerusalem")
+KIND = "momentum-holdings-for-classic-v1"
+SOURCE = "user-Momentum-HHHGDTJ"
+PORTFOLIO = "Momentum-HHHGDTJ"
+MIRROR_ID = 11630170
+MAX_AGE_S = 60
+REASON = "CROSS_BOOK_OVERLAP"
+
+
+def _parse_ts(s: Any) -> Optional[datetime]:
+    if not s:
+        return None
+    try:
+        t = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
+    except ValueError:
+        # fractional seconds with > 6 digits (e.g. .5918216Z)
+        head, _, frac = str(s).replace("Z", "").partition(".")
+        try:
+            t = datetime.fromisoformat(head + ("." + frac[:6] if frac else "") + "+00:00")
+        except ValueError:
+            return None
+    return t if t.tzinfo else None
+
+
+def extract_json(text: str) -> dict:
+    """Raw MCP response (may be wrapped in a tool fence) -> dict."""
+    i, j = text.find("{"), text.rfind("}")
+    if i < 0 or j <= i:
+        raise ValueError("no JSON object in response")
+    return json.loads(text[i:j + 1])
+
+
+def build_snapshot(resp: dict) -> dict[str, Any]:
+    if resp.get("error") or int(resp.get("statusCode") or 0) != 200:
+        raise ValueError(f"response not OK: statusCode={resp.get('statusCode')} error={resp.get('error')}")
+    ts = _parse_ts(resp.get("timestamp"))
+    if ts is None:
+        raise ValueError("response timestamp missing")
+    holdings, pend = [], []
+
+    def take(block: dict, origin: str):
+        for p in block.get("positions") or []:
+            m = p.get("market") or {}
+            holdings.append({"symbol": str(m.get("symbol") or "").upper(), "instrumentId": m.get("instrumentId"),
+                             "positionId": p.get("positionId"), "origin": origin})
+        for o in block.get("orders") or []:
+            m = o.get("market") or {}
+            if str(o.get("status")) in ("canceled", "rejected", "expired"):
+                continue
+            pend.append({"symbol": str(m.get("symbol") or o.get("symbol") or "").upper(),
+                         "instrumentId": m.get("instrumentId", o.get("instrumentId")), "status": o.get("status"),
+                         "origin": origin})
+
+    take(resp.get("direct") or {}, "direct")
+    for mr in resp.get("mirrors") or []:
+        take(mr, f"mirror:{mr.get('mirrorId')}")
+    allh = holdings + pend
+    return {"kind": KIND, "source": SOURCE, "portfolio": PORTFOLIO, "mirrorId": MIRROR_ID,
+            "account": resp.get("account", "real"), "read_only": True,
+            "asOf": ts.astimezone(IDT).isoformat(timespec="seconds"), "xRequestId": resp.get("xRequestId"),
+            "symbols": sorted({h["symbol"] for h in allh if h["symbol"]}),
+            "instrumentIds": sorted({int(h["instrumentId"]) for h in allh if h.get("instrumentId") is not None}),
+            "holdings": holdings, "pendingBuyOrders": pend,
+            "rule": "Classic never buys a symbol/instrument held in Momentum (Ofer 2026-10-13 01:44 IDT)"}
+
+
+def snapshot_path() -> Path:
+    P = paths()
+    return Path(P["momentum"])
+
+
+def write_snapshot(snap: dict, path: Optional[Path] = None) -> Path:
+    p = Path(path or snapshot_path())
+    p.parent.mkdir(parents=True, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(dir=p.parent, prefix=".momentum-", suffix=".json")
+    with os.fdopen(fd, "w") as fh:
+        json.dump(snap, fh, indent=2)
+        fh.write("\n")
+    os.replace(tmp, p)
+    return p
+
+
+def load_snapshot(now: Optional[datetime] = None) -> dict[str, Any]:
+    """{ok, error, age_s, symbols:set, ids:set, asOf, xRequestId, path}; ok=False if missing/unreadable/bad."""
+    p = snapshot_path()
+    out: dict[str, Any] = {"ok": False, "path": str(p), "symbols": set(), "ids": set()}
+    if not p.exists():
+        out["error"] = "MOMENTUM_SNAPSHOT_MISSING"
+        return out
+    try:
+        d = json.loads(p.read_text())
+        ts = _parse_ts(d.get("asOf"))
+        if d.get("kind") != KIND or ts is None or not isinstance(d.get("symbols"), list):
+            out["error"] = "MOMENTUM_SNAPSHOT_INVALID"
+            return out
+        out.update(symbols={str(s).upper() for s in d["symbols"]}, ids={int(i) for i in d.get("instrumentIds") or []},
+                   asOf=d.get("asOf"), xRequestId=d.get("xRequestId"))
+        if now is not None:
+            out["age_s"] = round((now - ts).total_seconds(), 1)
+        out["ok"] = True
+    except (ValueError, TypeError) as exc:
+        out["error"] = f"MOMENTUM_SNAPSHOT_INVALID: {exc}"
+    return out
+
+
+def overlaps(snap: dict, symbol: Any, instrument_id: Any) -> bool:
+    s = str(symbol or "").upper()
+    try:
+        iid = int(instrument_id) if instrument_id is not None else None
+    except (TypeError, ValueError):
+        iid = None
+    return bool(s and s in snap.get("symbols", set())) or (iid is not None and iid in snap.get("ids", set()))
+
+
+def filter_buy_packs(packs: list[dict], snap: Optional[dict] = None) -> tuple[list[dict], list[dict]]:
+    """Drop buy packs whose symbol/instrument is held in Momentum. Missing/invalid snapshot => drop ALL
+    (fail closed). Returns (kept, skipped[{symbol, instrumentId, reason}])."""
+    snap = snap if snap is not None else load_snapshot()
+    kept, skipped = [], []
+    for p in packs:
+        inst = p.get("instrument") or {}
+        sym, iid = inst.get("symbol") or p.get("symbol"), inst.get("instrumentId", p.get("instrumentId"))
+        if not snap.get("ok"):
+            skipped.append({"symbol": sym, "instrumentId": iid, "reason": snap.get("error") or "MOMENTUM_SNAPSHOT_MISSING"})
+        elif overlaps(snap, sym, iid):
+            skipped.append({"symbol": sym, "instrumentId": iid, "reason": REASON,
+                            "momentum_asOf": snap.get("asOf"), "momentum_xRequestId": snap.get("xRequestId")})
+        else:
+            kept.append(p)
+    return kept, skipped
+
+
+def filter_symbols(symbols: list[str], snap: Optional[dict] = None) -> tuple[list[str], list[dict]]:
+    """Rebalance target logic: buy candidates minus Momentum holdings (missing snapshot => none)."""
+    snap = snap if snap is not None else load_snapshot()
+    kept, skipped = [], []
+    for s in symbols:
+        if not snap.get("ok"):
+            skipped.append({"symbol": s, "reason": snap.get("error") or "MOMENTUM_SNAPSHOT_MISSING"})
+        elif overlaps(snap, s, None):
+            skipped.append({"symbol": s, "reason": REASON})
+        else:
+            kept.append(s)
+    return kept, skipped
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description="Write the read-only Momentum holdings snapshot from a saved "
+                                             "get-my-positions-and-orders response (never calls eToro).")
+    ap.add_argument("--response", required=True)
+    a = ap.parse_args(argv)
+    snap = build_snapshot(extract_json(Path(a.response).read_text()))
+    p = write_snapshot(snap)
+    print(json.dumps({"path": str(p), "asOf": snap["asOf"], "xRequestId": snap["xRequestId"],
+                      "symbols": snap["symbols"], "instrumentIds": snap["instrumentIds"]}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
